{
	"name": "invis/sentry",
	"description": "Sentry error reporting for Kirby",
	"type": "kirby-plugin",
	"license": "MIT",
	"require": {
		"php": "^8.5",
		"sentry/sentry": "^4.0",
		"php-http/curl-client": "^2.3",
		"guzzlehttp/psr7": "^2.0"
	},
	"config": {
		"secure-http": true,
		"allow-plugins": {
			"php-http/discovery": true
		}
	}
}

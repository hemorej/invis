{
	"name": "payments/payments",
	"description": "Payment connectors for Stripe",
	"type": "kirby-plugin",
	"license": "MIT",
	"version": "1.0.0",
	"authors": [
		{
			"name": "Jerome Arfouche",
			"email": "hello@jerome-arfouche.com",
			"homepage": "https://jerome-arfouche.com"
		}
	],
    "require": {
        "php": "^8.5",
        "stripe/stripe-php": "^22.1.0"
    },
	"autoload": {
		"psr-4": {
		  "Payments\\": "src/"
		}
	},
	"config": {
		"secure-http": true,
		"allow-plugins": {
			"cweagans/composer-configurable-plugin": true
		}
	}
}

use Kirby\Cms\Page;

return [
	'env' => 'dev',
	'geolocation' => (object)[
		'ip' => '',
		'network' => '',
		'city' => '',
		'region' => '',
		'region_code' => '',
		'country' => '',
		'country_name' => '',
		'country_code' => '',
		'country_tld' => '',
		'in_eu' => '',
		'timezone' => '',
		'country_calling_code' => '',
		'currency' => '',
		'currency_name' => '',
	],

	'debug' => true,

	'content' => [ 'salt' => '' ],
   'cookie'  => [ 'key'  => '' ],

	'cache' => [
		'pages' => [
			'active' => true,
			'type' => 'static',
			// nginx serves the cached files itself and can't read a header block, so keep the
			// files body-only. (`true` is only for the PHP loader / Apache / Caddy.)
			'headers' => false,
			// Page ids; array entries are exact matches (no wildcards), hence the closure.
			'ignore' => function ($page) {
				$id = $page->id();
				return $id === 'home' || $id === 'prints' || str_starts_with($id, 'prints/');
			},
		],
	],

	'thumbs' => [
		'quality' => 90,
		'format' => 'webp',
	    'driver' => 'imagick',
		'srcsets' => [
			'default' => [600, 800, 1200],
			'vertical' => ['400w' => ['height' => 600], '800w' => ['height' => 1200], '1350w' => ['height' => 2000]],
		],
	],

	'mailgun_domain' => '',
	'mailgun_key' => '',
	'alert_address' => '',
	'sentry_dsn' => '', // empty disables Sentry (site/plugins/sentry)
	'from_address' => '',
	'reply-to_address' => '',

	'stripe_key_pub' => '',
	'stripe_key_prv' => '',
	'webhook_secret' => '',

	'fixer_key' => '',
	'ipapi_key' => '',

	'cacheTTL' => '14400',

	'auth' => [
		'trials' => 5,
		'challenges' => ['totp', 'email'],
		'methods' => [
			'password' => ['2fa' => true],
		],
	],



	'hooks' => [
		'page.update:after' => function ( $newPage, $oldPage ) {
			$updateHandler = new PageUpdateHandler();
			$updateHandler->handle( $newPage, $oldPage );
		},
	],
];

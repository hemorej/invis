# Supply-chain safety net: never run install/postinstall scripts from
# dependencies. esbuild's platform binary and purgecss don't need
# lifecycle scripts to work (verified with `pnpm run build`); this
# blocks arbitrary code execution from a compromised package's
# install hooks. `allowBuilds` in pnpm-workspace.yaml is a separate,
# narrower allowlist mechanism and is unaffected by this setting.
ignore-scripts=true
